# LinkFort environment template
# Copy this file to .env for local development and configure the same values
# in your hosting dashboards for production.

# Backend runtime
FLASK_ENV=development
DEBUG=true
PORT=5000
REDIRECT_TO_FRONTEND=false

# Database
# Local: postgresql://linkfort_user:postgres@localhost:5432/linkfort
# Neon:  postgresql://user:password@ep-xxx.neon.tech/linkfort?sslmode=require
DATABASE_URL=postgresql://linkfort_user:postgres@localhost:5432/linkfort

# Redis (optional)
# Local: redis://localhost:6379/0
# Hosted: your provider connection string
# Leave empty to run without Redis.
REDIS_URL=

# Security
# Generate a new value before production deployment
SECRET_KEY=dev-secret-key-change-in-production

# URLs
# Local development defaults
BASE_URL=http://localhost:5000
SHORT_URL_BASE=http://localhost:5000
API_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Production examples
# BASE_URL=https://linkfort-api.onrender.com
# SHORT_URL_BASE=https://linkfort-api.onrender.com
# API_BASE_URL=https://linkfort-api.onrender.com
# FRONTEND_URL=https://linkfort.vercel.app
# REDIRECT_TO_FRONTEND=true

# Threat detection APIs
VIRUSTOTAL_API_KEY=your-virustotal-api-key-here
GOOGLE_SAFE_BROWSING_API_KEY=your-google-safe-browsing-key-here
