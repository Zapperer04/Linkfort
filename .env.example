# Backend Environment Variables - TEMPLATE
# Copy to .env and fill in with actual values
# DO NOT commit .env with secrets to git

# Environment
FLASK_ENV=development
DEBUG=true

# Database
# Example: postgresql://linkfort_user:password@localhost:5432/linkfort
# For Neon: postgresql://user:password@ep-xxx.neon.tech/linkfort?sslmode=require
DATABASE_URL=postgresql://linkfort_user:postgres@localhost:5432/linkfort

# Redis (for caching and rate limiting)
# Example: redis://localhost:6379/0
# For Upstash or Redis Cloud, use their connection string
REDIS_URL=redis://localhost:6379/0

# Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-secret-key-change-in-production

# URLs for CORS and short link generation
BASE_URL=http://localhost:5000
SHORT_URL_BASE=http://localhost:5000
API_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# External APIs
# Get from: https://www.virustotal.com/gui/home/upload (free tier)
VIRUSTOTAL_API_KEY=your-virustotal-api-key-here

# Get from: https://developers.google.com/safe-browsing/v4
GOOGLE_SAFE_BROWSING_API_KEY=your-google-safe-browsing-key-here

# Port (optional, defaults to 5000)
PORT=5000
